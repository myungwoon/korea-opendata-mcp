# 이 파일을 .env 로 복사한 뒤 사용할 서비스의 키만 채우세요. 비워 둔 서비스의 도구만 쓸 수 없습니다.
# .env 는 .gitignore 에 들어 있어 git 에 올라가지 않습니다.

# 공공데이터포털 일반 인증키 (Decoding/Encoding 둘 다 가능) — https://www.data.go.kr
# 날씨·미세먼지·공휴일·관광 도구. 각 API 마다 [활용신청] 필요:
#   기상청_단기예보 조회서비스 / 한국환경공단_에어코리아_대기오염정보 /
#   한국천문연구원_특일 정보 / 한국관광공사_국문 관광정보 서비스_GW
DATA_GO_KR_SERVICE_KEY=

# 한국은행 ECOS 인증키 — https://ecos.bok.or.kr/api/   (시험용: sample)
# 환율·기준금리·100대 통계지표 도구
ECOS_API_KEY=

# 서울 열린데이터광장 '실시간 지하철' 인증키 — https://data.seoul.go.kr   (시험용: sample)
# 지하철 실시간 도착정보 도구
SEOUL_OPENAPI_KEY=
